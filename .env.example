# Copia este archivo a .env y rellena SOLO lo que uses. Todo es opcional: los feeds RSS funcionan sin claves.
PORT=3000
# Finnhub (plan gratis: 60 llamadas/min) -> https://finnhub.io
FINNHUB_KEY=
# Alpha Vantage (plan gratis: 25 llamadas/dia, trae sentimiento) -> https://www.alphavantage.co
ALPHAVANTAGE_KEY=
# Polygon.io (plan gratis: 5 llamadas/min, noticias con retraso) -> https://polygon.io
POLYGON_KEY=
# NewsAPI.org: el plan gratis es solo para desarrollo (retraso de 24 h, prohibido en produccion). Dejar vacio en produccion.
NEWSAPI_KEY=
# 0 = muestra tambien noticias de bajo impacto sin activo (por defecto se filtran)
FILTER_NOISE=1
# Calendario economico (feed no oficial de Forex Factory). 0 para apagarlo
CALENDAR=1
# Segundos entre lecturas de cada RSS (en ms). Menos de 30000 puede hacer que te bloqueen
RSS_MS=60000
# Feeds RSS extra separados por coma
EXTRA_RSS=
# Si sirves la pagina desde otro dominio, pon su origen aqui
ALLOW_ORIGIN=
